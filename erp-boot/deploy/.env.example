# 复制为 .env 后填真实值；.env 不要提交到版本库
# 上传到服务器后放在 /www/java/erp-boot/.env

# Spring profile：prod 会关闭 Swagger、关闭 SQL 打印、不外泄异常信息
SPRING_PROFILES_ACTIVE=prod

# MySQL：宝塔宿主机上的实例（容器通过 host.docker.internal 访问）
# 库与账号已在宝塔面板里创建好，密码与面板中显示的一致
DB_URL="jdbc:mysql://host.docker.internal:3306/erp_db?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true"
DB_USERNAME=erp_db
DB_PASSWORD=请填写

# JWT：至少 64 位随机串，生成：openssl rand -base64 48
JWT_SECRET=请替换为至少64位随机字符串

# Redis：ERP 专用容器，密码与 docker-compose.yml 里的 redis 服务共用
REDIS_PASSWORD=请填写
# REDIS_HOST / REDIS_PORT 由 docker-compose.yml 的 environment 覆盖为容器内网地址，这里不用填

# 生产不开放接口文档
SPRINGDOC_ENABLED=false

# ==================== 镜像仓库（腾讯云 TCR 个人版） ====================
# 填 TCR 控制台给的仓库地址 + 命名空间 + 仓库名，例如 ccr.ccs.tencentyun.com/erp-boot/erp
# 本地 deploy/release.sh 也会读取这个值（或直接用同名环境变量覆盖）
REGISTRY=ccr.ccs.tencentyun.com/erp-boot/erp
# 镜像版本：deploy/release.sh 会自动传入；手动部署时改成具体版本
TAG=latest
